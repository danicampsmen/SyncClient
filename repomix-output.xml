      const { pairId } = req.body;
      if (!isValidString(pairId, 256)) {
        return res.status(400).json({ error: "pairId inválido" });
      }
      await syncEngine.pausePair(pairId);
      res.json({ success: true, status: syncEngine.getStatus() });
