    app.use(express.static(distPath));
    app.get('*', (req, res) => {
      res.sendFile(path.join(distPath, 'index.html'));
    });
  }

  const httpServer = app.listen(PORT, HOST, () => {
    console.log(`[Info] Servidor backend activo en http://${HOST}:${PORT}`);
  }).on('error', (err: any) => {
    if (err.code === 'EADDRINUSE') {
