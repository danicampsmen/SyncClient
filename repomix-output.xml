  });

  it('skips polling only during the mandatory cooldown', () => {
    const now = 100_000;
    expect(shouldSkipPoll(now - SYNC_COOLDOWN_MS + 1, now)).toBe(true);
    expect(shouldSkipPoll(now - SYNC_COOLDOWN_MS, now)).toBe(false);
