      } catch (error) {
        console.error('[Error] Error al detener el motor de sincronización:', error);
      }
      Logger.close();
      process.exit(0);
    });
  };

  // Escuchar señales de terminación
  process.on('SIGINT', () => gracefulShutdown('SIGINT'));
  process.on('SIGTERM', () => gracefulShutdown('SIGTERM'));
}

