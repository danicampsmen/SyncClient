  app.post("/api/sync/pairs", async (req, res) => {
    try {
      const { pairs } = req.body;
      if (!isValidArray(pairs) || pairs.length > 100 || !pairs.every(isValidSyncPair)) {
        return res.status(400).json({ error: "pairs debe ser un array" });
