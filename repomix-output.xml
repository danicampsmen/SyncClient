        new Logger('API').warn('[API] Invalid pairs payload (not array or too large)');
        new Logger('API').debug('pairs payload', { pairs });
        return res.status(400).json({ error: "pairs debe ser un array y no exceder 100 elementos" });
      }

      const invalidDetails: any[] = [];
      for (let i = 0; i < pairs.length; i++) {
        const p = pairs[i];
        const reasons: string[] = [];
        if (!p || typeof p !== 'object') reasons.push('not an object');
        if (!isValidString((p as any).id, 256)) reasons.push('id inválido');
        const localPath = typeof (p as any).localPath === 'string' && (p as any).localPath.startsWith('~/')
          ? path.join(os.homedir(), (p as any).localPath.slice(2))
          : (p as any).localPath;
        if (!isValidString(localPath, 4096)) reasons.push('localPath inválido o demasiado largo');
        else if (!isPathAllowed(localPath)) reasons.push('localPath no permitido por política de seguridad');
        if (!isValidString((p as any).remotePath, 2048)) reasons.push('remotePath inválido');
        if (!['bidirectional', 'upload', 'download'].includes((p as any).direction as string)) reasons.push('direction inválido');
        if (!['idle', 'syncing', 'error', 'paused', 'unauthenticated'].includes((p as any).status as string)) reasons.push('status inválido');
        if ((p as any).lastSynced !== null && typeof (p as any).lastSynced !== 'number') reasons.push('lastSynced debe ser null o número');
        if ((p as any).accountId !== undefined && !isValidString((p as any).accountId, 256)) reasons.push('accountId inválido');
        if ((p as any).driveId !== undefined && !isValidString((p as any).driveId, 256)) reasons.push('driveId inválido');
        if ((p as any).syncMode !== undefined && !['mirror', 'streaming'].includes((p as any).syncMode as string)) reasons.push('syncMode inválido');
        if ((p as any).cloudCategory !== undefined && !['computers', 'shared'].includes((p as any).cloudCategory as string)) reasons.push('cloudCategory inválido');
        if (reasons.length > 0) invalidDetails.push({ index: i, id: (p as any).id, reasons });
      }

      if (invalidDetails.length > 0) {
        new Logger('API').warn('[API] Invalid pairs details:', invalidDetails);
        return res.status(400).json({ error: 'pairs contiene entradas inválidas', details: invalidDetails });
      }

      await syncEngine.setPairs(pairs);
      res.json({ success: true, status: syncEngine.getStatus() });
    } catch (err: any) {
