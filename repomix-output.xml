describe('CoreSyncLogic.computeSyncPlan - conflict edge cases', () => {
  const remoteFile = (overrides: Partial<RemoteEntry> = {}): RemoteEntry => ({
    id: 'remote-1',
    name: 'nota.pdf',
    mimeType: 'application/pdf',
    modifiedTime: '1970-01-01T00:00:10.000Z',
