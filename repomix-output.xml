                                event.action === 'sync_start' || event.action === 'sync_end' || event.action === 'info' ? 'bg-cyan-500/10 text-cyan-300 border-cyan-500/30' :
                                  'bg-amber-500/10 text-amber-300 border-amber-500/30'
