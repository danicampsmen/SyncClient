            ) : (
              displayedEvents.map(event => {
                const pair = pairs.find(p => p.id === event.pairId);
                const formattedSize = (() => {
                  if (event.size && event.size > 0) {
                    const k = 1024;
                    const sizes = ['B', 'KB', 'MB', 'GB'];
                    const i = Math.floor(Math.log(event.size) / Math.log(k));
                    return parseFloat((event.size / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
                  }
                  if (event.details) {
                    const match = event.details.match(/(\d+(?:\.\d+)?\s*(?:B|KB|MB|GB))/i);
                    if (match) return match[1];
                  }
                  if (pair?.progress && pair.progress.currentFile === event.filename && pair.progress.totalBytes > 0) {
                    const k = 1024;
                    const sizes = ['B', 'KB', 'MB', 'GB'];
                    const i = Math.floor(Math.log(pair.progress.totalBytes) / Math.log(k));
                    return parseFloat((pair.progress.totalBytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
