# SyncClient — Variables de entorno

# CORS_ORIGIN: Origen permitido para peticiones CORS al backend.
# Por defecto, el servidor restringe CORS a http://localhost:3000 y http://127.0.0.1:3000.
# Si despliegas en un origen diferente, configúralo aquí.
# Ejemplo: CORS_ORIGIN=https://mi-dominio.com
CORS_ORIGIN=

# VITE_BACKEND_URL: URL del backend para el frontend en Android/Capacitor.
# En desarrollo local, si adb reverse no funciona, usa la IP local de tu PC.
# En producción, usá tu dominio público.
# Ejemplo dev: VITE_BACKEND_URL=http://192.168.1.50:3000
# Ejemplo prod: VITE_BACKEND_URL=https://sync.midominio.com
VITE_BACKEND_URL=

# HOST: Interfaz de red en la que escucha el servidor backend.
# Por defecto 127.0.0.1 (solo local). Para acceso desde la tablet en misma red, usa 0.0.0.0.
# En producción detrás de proxy reverso, dejá 127.0.0.1.
# Ejemplo: HOST=0.0.0.0
HOST=

# PORT: Puerto del backend (default 3000)
PORT=3000

# NODE_ENV: Establece el entorno de ejecución.
# Usar "production" para servir archivos estáticos desde dist/ en lugar de usar Vite middleware.
# NODE_ENV=production

# Firebase / Google OAuth client configuration for desktop and browser.
# Keep these values public and environment-scoped; do not commit secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_OAUTH_CLIENT_ID=

# Firma Android release. Nunca incluyas estos valores ni el keystore en Git.
# SYNCCLIENT_KEYSTORE_FILE=/ruta/absoluta/syncclient-release-key.keystore
# SYNCCLIENT_KEYSTORE_PASSWORD=
# SYNCCLIENT_KEY_ALIAS=syncclient
# SYNCCLIENT_KEY_PASSWORD=
